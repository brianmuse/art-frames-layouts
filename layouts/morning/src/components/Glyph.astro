---
import { glyphs } from '../lib/glyphs';
interface Props { name: keyof typeof glyphs; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="#d8e2d7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={glyphs[name]} /></svg>
<style>svg { width: 1em; height: 1em; flex-shrink: 0; }</style>
