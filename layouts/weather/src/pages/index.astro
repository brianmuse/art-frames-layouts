---
import Frame from '../layouts/Frame.astro';
import { glyph } from '../lib/glyphs';
// The middleware builds the page model. Astro escapes all text; nothing uses set:html.
const page = Astro.locals.page as Record<string, any>;
const forecast = page.forecast;
const weather = forecast.weather;
const layout = page.layout;
const degrees = (value: any) => typeof value === 'number' ? `${value}°` : '—';
const percent = (value: any) => typeof value === 'number' ? `${value}%` : '—';
// The renderer draws SVG without CSS colors, so each icon gets its stroke here.
const ink = '#f5f7f0', muted = '#d8e2d7', rain = '#a9cbe6';
const showRain = (value: any) => typeof value === 'number' && value >= 10;
const laterToday = weather?.hours.every((hour: any) => !hour.later);
---
<Frame title="Weather" serverRendered>
<div id="screen" class:list={{ plain: !page.art }}>
  {page.art && <img id="art" src={page.art.image} alt="" />}
  <main id="content" style={layout.style}>
    <section class="day">
      <p class="eyebrow">{forecast.place || 'Weather'}</p>
      <p class="date">{forecast.day}, {forecast.date}</p>
      {forecast.message && <div class="message">
        <p class="message-title">{forecast.message.title}</p>
        <p class="message-detail">{forecast.message.detail}</p>
      </div>}
      {weather && <div class="now">
        <svg class="now-glyph" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={glyph(weather.icon)} /></svg>
        <p class="temperature">{degrees(weather.current)}</p>
        <div class="now-words">
          <p class="conditions">{weather.label}</p>
          {typeof weather.feels === 'number' && <p class="feels">Feels like {weather.feels}°</p>}
        </div>
      </div>}
      {weather && <dl class="facts">
        <div><dt>High</dt><dd>{degrees(weather.high)}</dd></div>
        <div><dt>Low</dt><dd>{degrees(weather.low)}</dd></div>
        <div><dt>{weather.rainLabel}</dt><dd>{percent(weather.rain)}</dd></div>
        {weather.sunrise && <div class="sun"><dt>Sunrise</dt><dd>{weather.sunrise}</dd></div>}
        {weather.sunset && <div class="sun"><dt>Sunset</dt><dd>{weather.sunset}</dd></div>}
      </dl>}
      {weather?.hours.length > 0 && <div class="hourly">
        <p class="eyebrow">{laterToday ? 'Later today' : 'Next hours'}</p>
        <ol class="hours">
          {weather.hours.map((hour: any) => <li class:list={{ later: hour.later, 'new-day': hour.day }}>
            {!laterToday && <span class="hour-day">{hour.day || '\u00a0'}</span>}
            <span class="hour-time">{hour.time}</span>
            <svg class="hour-glyph" viewBox="0 0 24 24" fill="none" stroke={muted} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={glyph(hour.icon)} /></svg>
            <span class="hour-temp">{degrees(hour.temperature)}</span>
            <span class="hour-rain">{showRain(hour.rain) ? `${hour.rain}%` : ' '}</span>
          </li>)}
        </ol>
      </div>}
      {forecast.updated && <p class="updated">{forecast.updated}</p>}
    </section>
    {weather?.week.length > 0 && <section class="week">
      <p class="eyebrow">This week</p>
      <ol>
        {weather.week.map((day: any) => <li class:list={{ today: day.name === 'Today' }}>
          <span class="week-name">{day.name}</span>
          <svg class="week-glyph" viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={glyph(day.icon)} /></svg>
          <span class="week-rain">{showRain(day.rain) ? `${day.rain}%` : ' '}</span>
          <span class="week-low">{degrees(day.low)}</span>
          <span class="week-bar"><span class="track">
            <span class="fill" style={`left:${day.bar.left.toFixed(1)}%;width:${day.bar.width.toFixed(1)}%;background:linear-gradient(90deg,${day.bar.from},${day.bar.to})`}></span>
            {typeof day.bar.now === 'number' && <span class="now-dot" style={`left:${day.bar.now.toFixed(1)}%`}></span>}
          </span></span>
          <span class="week-high">{degrees(day.high)}</span>
        </li>)}
      </ol>
    </section>}
  </main>
</div>
</Frame>
<style>
  :global(body) {
    --screen-u: min(1vw, calc(1vh * 16 / 9)); --u: var(--screen-u);
    --ink: #f5f7f0; --muted: #d8e2d7; --accent: #d1dfbe; --rain: #a9cbe6; --line: rgba(255,255,255,.22);
    background: #161e1b; color: var(--ink); display: grid; place-items: center;
  }
  #screen { position: relative; width: calc(var(--u) * 100); height: calc(var(--u) * 56.25); overflow: hidden; background: #35463e; font-size: calc(var(--u) * 1); }
  /* Without art: the same calm deep green as the news layout. */
  #screen.plain { background: linear-gradient(155deg, #314339 0%, #27362f 30%, #1d2924 62%, #151d1a 100%); }
  #art { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; background: #e9e2d7; }
  #content { position: absolute; z-index: 1; left: var(--content-x,0%); top: var(--content-y,0%); width: var(--content-width,100%); height: var(--content-height,100%); overflow: hidden; --u: calc(var(--screen-u) * var(--content-scale,1)); }
  /* Dark fades behind the text on the left and right; the middle of the art stays clear. */
  #content::before { content: ""; position: absolute; inset: 0; background: linear-gradient(40deg, rgba(8,20,18,.88), rgba(8,20,18,.66) 34%, transparent 60%), linear-gradient(270deg, rgba(8,20,18,.88), rgba(8,20,18,.66) 42%, transparent 62%); }
  .plain #content::before { display: none; }
  p, ol, dl, dd { margin: 0; }
  ol { padding: 0; list-style: none; }
  .eyebrow { font-size: calc(var(--u) * .95); line-height: 1.3; font-weight: 600; letter-spacing: .12em; color: var(--accent); text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* The day: bottom left, the largest thing on screen. */
  .day { position: absolute; left: 4%; bottom: 7%; width: 40%; }
  .date { font-size: calc(var(--u) * 1.9); font-weight: 600; line-height: 1.2; letter-spacing: -.03em; color: var(--muted); margin-top: calc(var(--u) * .3); }
  .now { display: flex; align-items: center; margin-top: calc(var(--u) * 1.4); }
  .now-glyph { flex: 0 0 auto; width: calc(var(--u) * 7.4); height: calc(var(--u) * 7.4); margin-right: calc(var(--u) * 1.4); }
  .temperature { flex: 0 0 auto; font-size: calc(var(--u) * 10); font-weight: 400; line-height: 1; letter-spacing: -.05em; margin-right: calc(var(--u) * 1.8); }
  .now-words { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
  .conditions { font-size: calc(var(--u) * 2.2); line-height: 1.2; letter-spacing: -.02em; }
  .feels { font-size: calc(var(--u) * 1.3); line-height: 1.3; color: var(--muted); margin-top: calc(var(--u) * .4); }
  .facts { display: flex; margin-top: calc(var(--u) * 1.8); padding-top: calc(var(--u) * 1.1); border-top: 1px solid var(--line); }
  .facts > div { flex: 1 1 0; width: 16%; }
  .facts > .sun { flex: 1.45 1 0; width: 24%; }
  .facts dt { font-size: calc(var(--u) * .8); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); line-height: 1.3; }
  .facts dd { font-size: calc(var(--u) * 1.6); line-height: 1.25; margin-top: calc(var(--u) * .2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hourly { margin-top: calc(var(--u) * 1.4); padding-top: calc(var(--u) * 1.1); border-top: 1px solid var(--line); }
  .hours { display: flex; margin-top: calc(var(--u) * .5); }
  .hours li { flex: 1 1 0; width: 12.5%; text-align: center; }
  .hours li.new-day { border-left: 1px solid var(--line); }
  .hour-day { display: block; font-size: calc(var(--u) * .9); line-height: 1.3; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .hour-time { display: block; font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); white-space: nowrap; }
  .hour-glyph { display: block; width: calc(var(--u) * 2.2); height: calc(var(--u) * 2.2); margin: calc(var(--u) * .4) auto; }
  .hour-temp { display: block; font-size: calc(var(--u) * 1.5); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .hour-rain { display: block; font-size: calc(var(--u) * .9); line-height: 1.3; margin-top: calc(var(--u) * .2); color: var(--rain); font-weight: 600; }
  .updated { margin-top: calc(var(--u) * 1); font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); opacity: .85; }
  .message { margin-top: calc(var(--u) * 1.6); padding-top: calc(var(--u) * 1.1); border-top: 1px solid var(--line); }
  .message-title { font-size: calc(var(--u) * 2.2); line-height: 1.2; letter-spacing: -.02em; }
  .message-detail { font-size: calc(var(--u) * 1.3); line-height: 1.35; color: var(--muted); margin-top: calc(var(--u) * .4); }

  /* Then the week: bottom right, one row per day on a shared temperature scale. */
  .week { position: absolute; right: 4%; bottom: 7%; width: 36%; }
  .week ol { margin-top: calc(var(--u) * .6); }
  .week li { display: flex; align-items: center; height: calc(var(--u) * 4.6); border-top: 1px solid var(--line); }
  .week-name { flex: 0 0 auto; width: calc(var(--u) * 6.2); font-size: calc(var(--u) * 1.55); line-height: 1.2; }
  .week li.today .week-name { font-weight: 600; }
  .week-glyph { flex: 0 0 auto; width: calc(var(--u) * 2.5); height: calc(var(--u) * 2.5); margin-right: calc(var(--u) * .9); }
  .week-rain { flex: 0 0 auto; width: calc(var(--u) * 3.6); font-size: calc(var(--u) * 1.05); font-weight: 600; color: var(--rain); line-height: 1.2; }
  .week-low { flex: 0 0 auto; width: calc(var(--u) * 3.4); text-align: right; font-size: calc(var(--u) * 1.55); color: var(--muted); line-height: 1.2; font-variant-numeric: tabular-nums; }
  .week-bar { flex: 1 1 auto; padding: 0 calc(var(--u) * 1.1); }
  .track { display: block; position: relative; height: calc(var(--u) * .5); border-radius: calc(var(--u) * .25); background: rgba(255,255,255,.14); }
  .fill { position: absolute; top: 0; bottom: 0; border-radius: calc(var(--u) * .25); }
  .now-dot { position: absolute; top: 50%; width: calc(var(--u) * .9); height: calc(var(--u) * .9); margin: calc(var(--u) * -.45) 0 0 calc(var(--u) * -.45); border-radius: 50%; background: #ffffff; border: calc(var(--u) * .15) solid #1b2622; }
  .week-high { flex: 0 0 auto; width: calc(var(--u) * 3.4); font-size: calc(var(--u) * 1.55); line-height: 1.2; font-variant-numeric: tabular-nums; }
</style>
