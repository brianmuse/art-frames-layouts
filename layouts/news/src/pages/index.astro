---
import Frame from '../layouts/Frame.astro';
import { weatherGlyph } from '../lib/glyphs';
// The middleware builds the page model. All feed text is escaped by Astro; nothing uses set:html.
const page = Astro.locals.page as Record<string, any>;
const news = page.news;
const layout = page.layout;
const weather = news.weather;
const degrees = (value: any) => typeof value === 'number' ? `${value}°` : '—';
const headlines = news.headlines.slice(0, layout.count);
---
<Frame title="News & weather" serverRendered>
<div id="screen" class:list={{ plain: !page.art }}>
  {page.art && <img id="art" src={page.art.image} alt="" />}
  <main id="content" style={layout.style}>
    <section class="glance">
      <h1 class="day">{news.day}</h1>
      <p class="date">{news.date}</p>
      {weather && (weather.unavailable
        ? <div class="weather"><p class="eyebrow"><span>Outside</span>{weather.location && <span class="place"> · {weather.location}</span>}</p><p class="weather-message">{weather.message}</p></div>
        : <div class="weather">
            <p class="eyebrow"><span>Outside</span>{weather.location && <span class="place"> · {weather.location}</span>}</p>
            <div class="now">
              <svg class="now-glyph" viewBox="0 0 24 24" fill="none" stroke="#f5f7f0" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={weatherGlyph(weather.label)} /></svg>
              <p class="temperature">{typeof weather.current === 'number' ? `${weather.current}°${weather.unit}` : '—'}</p>
            </div>
            <p class="conditions">{weather.label}</p>
            <p class="range"><span>High {degrees(weather.high)}</span><span>Low {degrees(weather.low)}</span>{typeof weather.rain === 'number' && weather.rain >= 20 && <span>Rain {weather.rain}%</span>}</p>
            {weather.updated && <p class="weather-updated">{weather.updated}</p>}
            {weather.hours.length > 0 && <ol class="hours">
              {weather.hours.map((hour: any) => <li>
                <span class="hour-time">{hour.time}</span>
                <svg class="hour-glyph" viewBox="0 0 24 24" fill="none" stroke="#d8e2d7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={weatherGlyph(hour.label)} /></svg>
                <span class="hour-temp">{degrees(hour.temperature)}</span>
              </li>)}
            </ol>}
          </div>)}
    </section>
    <section class="headlines">
      <p class="eyebrow">{news.heading}</p>
      {headlines.length > 0 && <ol>
        {headlines.map((item: any, index: number) => <li class:list={{ 'one-line': layout.lines[index] === 1 }}>
          <h2>{item.title}</h2>
          <p class="meta">{item.topic && <span class="topic">{item.topic}</span>}<span>{[item.source, item.age].filter(Boolean).join(' · ')}</span></p>
        </li>)}
      </ol>}
      {news.empty && <p class="empty">{news.empty}</p>}
      {news.updated && <p class="updated">{news.updated}</p>}
      {news.status && <div class="status"><span class="status-mark">!</span><p><strong>{news.status.title}</strong><small>{news.status.detail}</small></p></div>}
    </section>
  </main>
</div>
</Frame>
<style>
  :global(body) {
    --screen-u: min(1vw, calc(1vh * 16 / 9)); --u: var(--screen-u);
    --ink: #f5f7f0; --muted: #d8e2d7; --accent: #d1dfbe; --line: rgba(255,255,255,.26);
    background: #161e1b; color: var(--ink); display: grid; place-items: center;
  }
  #screen { position: relative; width: calc(var(--u) * 100); height: calc(var(--u) * 56.25); overflow: hidden; background: #35463e; font-size: calc(var(--u) * 1); }
  /* Without art: a calm deep green, a little lighter toward the upper left. */
  #screen.plain { background: linear-gradient(155deg, #314339 0%, #27362f 30%, #1d2924 62%, #151d1a 100%); }
  #art { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; background: #e9e2d7; }
  #content { position: absolute; z-index: 1; left: var(--content-x,0%); top: var(--content-y,0%); width: var(--content-width,100%); height: var(--content-height,100%); overflow: hidden; --u: calc(var(--screen-u) * var(--content-scale,1)); }
  /* Dark fades behind the text on the left and right; the middle of the art stays clear. */
  #content::before { content: ""; position: absolute; inset: 0; background: linear-gradient(45deg, rgba(8,20,18,.86), rgba(8,20,18,.6) 20%, transparent 46%), linear-gradient(270deg, rgba(8,20,18,.88), rgba(8,20,18,.66) 42%, transparent 62%); }
  .plain #content::before { display: none; }
  h1, h2, p, ol { margin: 0; }
  ol { padding: 0; list-style: none; }
  .eyebrow { font-size: calc(var(--u) * .95); line-height: 1.3; font-weight: 600; letter-spacing: .12em; color: var(--accent); text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .glance { position: absolute; left: 4%; bottom: 6%; width: 30%; }
  .day { font-size: calc(var(--u) * 3.4); font-weight: 400; line-height: 1.1; letter-spacing: -.035em; }
  .date { font-size: calc(var(--u) * 1.9); font-weight: 600; line-height: 1.2; letter-spacing: -.03em; color: var(--muted); margin-top: calc(var(--u) * .2); }
  .weather { margin-top: calc(var(--u) * 2); padding-top: calc(var(--u) * 1.2); border-top: 1px solid var(--line); }
  .now { display: flex; align-items: center; gap: calc(var(--u) * .8); margin-top: calc(var(--u) * .5); }
  .now-glyph { width: calc(var(--u) * 3.3); height: calc(var(--u) * 3.3); }
  .temperature { font-size: calc(var(--u) * 3.9); font-weight: 600; line-height: 1.1; letter-spacing: -.03em; }
  .conditions { font-size: calc(var(--u) * 1.4); line-height: 1.25; margin-top: calc(var(--u) * .35); }
  .range { font-size: calc(var(--u) * 1.15); line-height: 1.3; color: var(--muted); margin-top: calc(var(--u) * .25); }
  .range span + span::before { content: "·"; padding: 0 calc(var(--u) * .5); }
  .weather-updated { font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); opacity: .85; margin-top: calc(var(--u) * .3); }
  .weather-message { font-size: calc(var(--u) * 1.3); line-height: 1.3; color: var(--muted); margin-top: calc(var(--u) * .5); }
  .hours { display: flex; margin-top: calc(var(--u) * 1.2); padding-top: calc(var(--u) * 1); border-top: 1px solid var(--line); }
  .hours li { flex: 1 1 0; width: 20%; text-align: center; }
  .hour-time { display: block; font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); white-space: nowrap; }
  .hour-glyph { display: block; width: calc(var(--u) * 1.9); height: calc(var(--u) * 1.9); margin: calc(var(--u) * .35) auto; }
  .hour-temp { display: block; font-size: calc(var(--u) * 1.35); line-height: 1.2; font-variant-numeric: tabular-nums; }

  .headlines { position: absolute; right: 4%; top: 4%; width: 40%; max-height: 92%; overflow: hidden; }
  .headlines > .eyebrow { margin-bottom: calc(var(--u) * 1); }
  .headlines li { padding: calc(var(--u) * var(--row-pad, .9)) 0; border-top: 1px solid var(--line); }
  .headlines h2 { font-size: calc(var(--u) * 1.5); font-weight: 400; line-height: 1.25; letter-spacing: -.02em; max-height: 2.5em; overflow: hidden; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }
  .headlines .one-line h2 { display: block; max-height: 1.25em; white-space: nowrap; text-overflow: ellipsis; }
  .meta { margin-top: calc(var(--u) * .3); font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .topic { font-weight: 600; letter-spacing: .1em; text-transform: uppercase; font-size: calc(var(--u) * .8); color: var(--accent); margin-right: calc(var(--u) * .7); }
  .empty { padding: calc(var(--u) * .6) 0; font-size: calc(var(--u) * 1.2); line-height: 1.3; color: var(--muted); border-top: 1px solid var(--line); }
  .updated { margin-top: calc(var(--u) * .8); font-size: calc(var(--u) * .95); line-height: 1.3; color: var(--muted); opacity: .85; }
  .status { display: flex; align-items: center; gap: calc(var(--u) * .5); margin-top: calc(var(--u) * .8); padding-top: calc(var(--u) * .8); border-top: 1px solid var(--line); color: var(--muted); }
  .status-mark { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: calc(var(--u) * 1); height: calc(var(--u) * 1); border: 1px solid currentColor; border-radius: 50%; font-size: calc(var(--u) * .7); }
  .status p { line-height: 1.25; }
  .status strong { display: block; font-size: calc(var(--u) * .9); font-weight: 600; }
  .status small { display: block; font-size: calc(var(--u) * .8); margin-top: calc(var(--u) * .15); }
</style>
