---
interface Props { title?: string; serverRendered?: boolean }
const { title = 'Art Frames', serverRendered = false } = Astro.props;
---
<!doctype html>
<html lang="en" data-dayframe-ready={serverRendered ? 'true' : undefined} data-dayframe-server-rendered={serverRendered ? 'true' : undefined}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title}</title></head>
  <body><slot /></body>
</html>
<style is:global>
  @font-face { font-family: Inter; src: url('/fonts/Inter-Regular.ttf'); font-weight: 400; }
  @font-face { font-family: Inter; src: url('/fonts/Inter-SemiBold.ttf'); font-weight: 600; }
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; }
  body { font-family: Inter, system-ui, sans-serif; background: #eee9df; color: #293b35; }
</style>
